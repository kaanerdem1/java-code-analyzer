<?xml version="1.0"?>
<ruleset name="Mock complexity (all methods)"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Cyclomatic, Cognitive and NPath with very low method thresholds so nearly every
        method produces a violation row in the XML report (compare with standalone JSON).
    </description>

    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="9999"/>
            <property name="methodReportLevel" value="1"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="1"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/NPathComplexity">
        <properties>
            <property name="reportLevel" value="1"/>
        </properties>
    </rule>
</ruleset>
