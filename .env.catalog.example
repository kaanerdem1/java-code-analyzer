# PostgreSQL katalog (bu repoda genel ".env" YOK — sadece bu dosya).
#
# Kurulum:
#   cp .env.catalog.example .env.catalog
#   # .env.catalog içini düzenle (git'e commit etme)
#
# run-analyze.sh / run-pmd-analyze.sh: .env.catalog varsa otomatik yükler.
# Dosya istemezseniz aynı değişkenleri shell'de export edin.
#
# CATALOG_SCHEMA=env  → PostgreSQL ŞEMA adı (pgAdmin: Schemas → env), dosya adı değil.
# Tablolar: psql -d inventory_db -f scripts/catalog-schema.sql
#   env.method_risk_analyze, env.method_similarity

# --- Seçenek A: JDBC (tercih) ---
CATALOG_JDBC_URL=jdbc:postgresql://localhost:5432/inventory_db
PGUSER=postgres
PGPASSWORD=

# Şema (varsayılan env)
CATALOG_SCHEMA=env

# Parser + PMD aynı koşuda eşleşsin diye sabitleyin (yoksa her tarama yeni UUID):
# export CATALOG_SCAN_RUN=$(uuidgen | tr '[:upper:]' '[:lower:]')
# CATALOG_SCAN_RUN=00000000-0000-0000-0000-000000000000

# Uzak sunucu örneği:
# CATALOG_JDBC_URL=jdbc:postgresql://db.example.com:5432/analyzer_catalog?sslmode=require
# PGUSER=catalog_writer
# PGPASSWORD=change-me

# DB yazımı hata verirse taramayı düşür (varsayılan: logla, devam et)
# CATALOG_FAIL_ON_ERROR=1
